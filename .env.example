# Environment configuration template
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file containing real keys.

# Pinecone Vector Database
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-week-3-py

# Local LLM & Embedding Models
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Default policy document (stored in resources/ folder)
RAG_DOCUMENT=InsurancePolicy.pdf

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=8501

# CORS Allowed Origins
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173
