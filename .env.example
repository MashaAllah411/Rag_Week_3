# Environment configuration template
# Copy this file to .env and adjust. NEVER commit your real .env file.
# Everything works with the defaults: no account or API key is required.
# A key whose preceding comment line contains [required] must be filled in; `python run.py`
# stops and lists any that are empty. Currently none are required.

# Local LLM & models (open source, run on your machine)
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Vector store: ChromaDB, embedded and persistent (created automatically)
VECTOR_STORE_DIR=data/vectorstore
VECTOR_STORE_COLLECTION=insurance_rag

# Tracing: OpenTelemetry. Spans always go to traces/otel_spans.jsonl.
# Optionally also ship them to any OTLP/HTTP collector, e.g. self-hosted Arize Phoenix:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=insurance-rag
OTEL_EXPORTER_OTLP_ENDPOINT=

# OCR: path to the Tesseract executable if it is not on PATH (optional)
# TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# Default policy document (stored in resources/ folder)
RAG_DOCUMENT=InsurancePolicy.pdf

# Server ports
BACKEND_PORT=8000
FRONTEND_PORT=8501

# CORS Allowed Origins
FRONTEND_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173
