# DocChat Pro / Insurance RAG Platform Configuration
# Copy this file to .env and fill in your keys

# LLM Provider: "groq" (fast cloud tier, ~1.5s latency) or "ollama" (local)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Hallucination Guard: minimum confidence threshold (0.0 to 1.0)
CONFIDENCE_THRESHOLD=0.45

# Ollama Model (only used if LLM_PROVIDER=ollama or as fallback)
OLLAMA_MODEL=llama3.2

# Ports & URLs
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
