# Environment variables (contains API keys - never commit!)
.env
.env.*
!.env.example

# Python cache & compiled bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
.venv/

# Logs & Traces
logs/
*.log
budget_termination.log

# HuggingFace & Pytest cache
.cache/
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Local backup directories
_backup/
*_backup/

# Generated local stores & exports (rebuilt automatically)
data/vectorstore/
traces/otel_spans.jsonl
traces/otel_spans.jsonl.1

# Keep archived files that would otherwise match the ignore patterns above
!legacy/build_artifacts/rag_week_3.egg-info/
!legacy/week07/*.log
